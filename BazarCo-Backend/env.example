# Server
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001
# If your API is served under a path (e.g. Render: /api), set API_PREFIX=api so routes become /api/kyc/verify etc. Set BASE_URL to the full backend URL (with /api if applicable) for email links.
API_PREFIX=
FRONTEND_URL=http://localhost:3000

# Database (use MONGO_URI for local, or cluster below)
MONGO_URI=mongodb://localhost:27017/bazarco
CLUSTER_MONGO_ENABLED=false
CLUSTER_MONGO_URI=

# Auth
JWT_SECRET=your-secret
CORS_ORIGIN=

# Mail (notify). ADMIN_MAIL = KYC verification emails (defaults to APP_MAIL)
APP_MAIL=
APP_PW=
ADMIN_MAIL=

# Shopify (for syncing products to your store)
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Cloudinary (product images – imageUrl is stored in DB, file is uploaded here)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Algolia (product search: name, description, price, category, tags, createdBy, shopifyProductId). Set attributesForFaceting to status, category, tags.
ALGOLIA_APP_ID=
ALGOLIA_WRITE_API_KEY=
ALGOLIA_INDEX_NAME=products
